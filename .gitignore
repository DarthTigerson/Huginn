# TypeScript composite build artifacts (electron-vite handles the real build,
# tsc -b is only used for type-checking). tsconfig.web.json/tsconfig.node.json
# route emit to .tsbuild/ via outDir, so nothing should land in src/ or
# electron/ directly anymore — the patterns below are just a safety net for
# anyone still holding an out-of-date checkout or an old-style tsc invocation
# (a stray .js sitting next to its .tsx/.ts source gets silently preferred by
# Vite's dev server over the real source, serving stale code with no error).
.tsbuild/
electron/**/*.js
electron/**/*.d.ts
# ...except electron/mobileWeb, which is hand-written JS served straight to
# mobile clients (no .ts source, not a compiled artifact) — re-include it.
!electron/mobileWeb/*.js
src/**/*.js
src/**/*.d.ts
electron.vite.config.js
electron.vite.config.d.ts
*.tsbuildinfo

